# 复制为 .env 后自行填写；Spring Boot 不自动读取 .env，参见 README。
SPRING_PROFILES_ACTIVE=dev
DB_URL="jdbc:mysql://127.0.0.1:3306/lab_reservation?connectionTimeZone=Asia/Shanghai&forceConnectionTimeZoneToSession=true"
DB_USERNAME=
DB_PASSWORD=
# 用安全随机源生成至少 32 字节的密钥；不能使用此空示例启动。
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEMO_ENABLED=false
DEMO_PASSWORD=
